# Python bytecode and tooling caches
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build and packaging outputs
build/
dist/
*.egg-info/

# Local environments and editor state
.env
.envrc
.venv/
venv/
env/
.idea/
.vscode/
.tools/

# Notebook state
.ipynb_checkpoints/

# Solver credentials and local configuration
secrets/
*.lic
.pypirc

# Raw, generated, and result data
data/raw/
data/processed/
data/results/
data/osrm/
cache/

# Locally generated examples
examples/*
!examples/.gitkeep
!examples/README.md
!examples/ofertas/
examples/ofertas/*
!examples/ofertas/.gitkeep

# Scheduler and temporary artifacts
slurm-*.out
*.old
